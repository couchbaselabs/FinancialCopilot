# Couchbase Capella credentials
# Find these in your Capella console under: Cluster > Connect > SDK
CB_ENDPOINT=couchbases://cb.<your-cluster-id>.cloud.couchbase.com
CB_USERNAME=your_username
CB_PASSWORD=your_password
CB_BUCKET=portfolio

PORT=3001

# ─── Copilot / LM Studio (optional) ───
# Repeat-question cache heuristic threshold (Jaccard fallback when LM Studio is off)
COPILOT_CACHE_SIMILARITY_THRESHOLD=0.82
# Semantic (embedding cosine) threshold for cache hits when LM Studio is on
COPILOT_SEMANTIC_THRESHOLD=0.75
# LM Studio OpenAI-compatible endpoint + models (see `lms ps` for identifiers)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_EMBED_MODEL=text-embedding-bge-m3-embeddings
LMSTUDIO_CHAT_MODEL=google/gemma-4-e4b
